# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Secrets / credentials — never commit these
.env
*.pem
*.key

# ADK scratch / temp
_smoke_test.py
/tmp/

# Project scratch
.scratch/

# Playwright MCP extraction + verification artifacts (kept locally,
# regenerable from the live site or static mockup; ~4 MB binary blobs)
.playwright-mcp/

# Local working files, not published to the public repo
docs/internal/
docs/boq/
docs/plan-a/
docs/plan-b/
docs/plan-c/
scripts/build_cloud_boq_xlsx.py
scripts/build_cloud_boq_xlsx.md
docs/screenshots/

# Static site mockup: kept local only, not part of the published repo
static-mockup-rebuild/

# Large submission binaries kept local; represented in-repo by the PDF
# deck and the demo video link in the README
docs/*.pptx
docs/*.mp4

# adk-web local dev path: kept local, not deployed. The README documents
# `adk web` as a local CLI; these two files only served a container deploy
# we decided against, so they stay local-only.
telecom_ops/Dockerfile
telecom_ops/requirements.txt

# SQLite-bundled reconstitution: the materialized DB file is regenerated
# from docs/seed-data/*.csv via scripts/build_sqlite.py; not committed.
data/
# scripts/deploy_toolbox.sh stages the SQLite file here for the Cloud Run
# build context, then cleans it up on exit. Belt-and-suspenders rule in
# case a deploy fails midway through.
toolbox-service/data/

# Cached genai-toolbox binary for local development (downloaded by
# scripts/run_toolbox_local.sh; ~30 MB, regenerable from upstream).
.toolbox/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp
