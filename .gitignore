# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Secrets / credentials — never commit these
.env
*.pem
*.key

# ADK scratch / temp
_smoke_test.py
/tmp/

# Project scratch
.scratch/

# Playwright MCP extraction + verification artifacts (kept locally,
# regenerable from the live site or static mockup; ~4 MB binary blobs)
.playwright-mcp/

# Internal-only docs (build journals, design spec, SSE wiring reference,
# migration plan) — kept locally, not published to the public repo
docs/internal/

# Iteration screenshots from the build process — not user-facing assets
docs/screenshots/

# Submission deck artifacts (large binaries + paste-prep notes, kept locally — not in git)
*.pptx
*.pptx.*
docs/Prototype Submission Deck*.pdf
docs/deck-rewrite.txt

# SQLite-bundled reconstitution: the materialized DB file is regenerated
# from docs/seed-data/*.csv via scripts/build_sqlite.py; not committed.
data/
# scripts/deploy_toolbox.sh stages the SQLite file here for the Cloud Run
# build context, then cleans it up on exit. Belt-and-suspenders rule in
# case a deploy fails midway through.
toolbox-service/data/

# Cached genai-toolbox binary for local development (downloaded by
# scripts/run_toolbox_local.sh; ~30 MB, regenerable from upstream).
.toolbox/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp
